# Maintainer: Steven Yepes <stevenyepes@aur.archlinux.org>
pkgname=demeteo
pkgver=1.0.0
pkgrel=1
pkgdesc="Fleet-style multi-agent orchestrator for software development"
arch=('x86_64')
url="https://github.com/stevenyepes/demeteo"
license=('MIT')
depends=(
  'cairo'
  'desktop-file-utils'
  'gdk-pixbuf2'
  'glib2'
  'gtk3'
  'hicolor-icon-theme'
  'libsoup3'
  'pango'
  'webkit2gtk-4.1'
  'gcc-libs'
  'sqlite'
)
makedepends=(
  'cargo'
  'nodejs>=20'
  'npm'
  'cmake'
  'pkgconf'
  'base-devel'
)
optdepends=(
  'opencode: opencode agent CLI'
  'claude-code: claude-code agent CLI'
  'hermes: hermes agent CLI'
)
provides=('demeteo')
conflicts=('demeteo')
# !lto: mixed Rust/C project (rusqlite + ssh2 + ring) — Arch Wiki:
# "The package itself is a mixed Rust/C/C++ project: disable the lto option."
options=('!strip' '!lto')
source=("https://github.com/stevenyepes/demeteo/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('83f9be2a0f113b6cbd7d4277c94ae0aec092235366e7d791c7f8840ca24d19f8')

prepare() {
  cd "${pkgname}-${pkgver}"
  npm ci
}

build() {
  cd "${pkgname}-${pkgver}"
  # Forward the release channel into the Rust compile (feeds the legacy
  # `RELEASE_CHANNEL` const). The user-facing About badge no longer reads
  # this — `get_app_version` derives NIGHTLY vs STABLE from the version's
  # `-` pre-release suffix — so the real fix for a correct badge is stamping
  # the true version below, not this var. Kept for the legacy path; harmless.
  export DEMETEO_RELEASE_CHANNEL="${DEMETEO_RELEASE_CHANNEL:-stable}"
  # Use system sqlite via pkg-config instead of bundling — Arch convention.
  export LIBSQLITE3_SYS_USE_PKG_CONFIG=1

  # Stamp the real app version into the bundle + binary. The committed
  # tauri.conf.json carries only the base version (e.g. 1.0.0); nightly RC
  # tarballs are cut from a tag WITHOUT mutating that manifest — CI injects
  # the true version at build time via `-c` (see .github/workflows/build.yml).
  # A plain AUR build would therefore compile the binary as "1.0.0" regardless
  # of the rc, so `app.package_info().version` — which drives the About screen
  # AND the version-keyed remote-runner download/upgrade check — would be
  # wrong, pulling a stale runner to remote hosts. When the caller provides the
  # true version (test-aur-install.sh exports the hyphenated PKGVER, e.g.
  # 1.0.0-12), mirror CI's runtime override so the binary self-reports it.
  # Stable builds leave it unset: the release tag's manifest is already correct.
  local tauri_args=(build -b deb)
  if [[ -n "${DEMETEO_APP_VERSION:-}" ]]; then
    printf '{\n  "version": "%s"\n}\n' "${DEMETEO_APP_VERSION}" \
      > .tauri-version-override.json
    tauri_args+=(-c .tauri-version-override.json)
  fi
  npm run tauri -- "${tauri_args[@]}"

  # Guard against Tailwind emitting a utility-less stylesheet. Tailwind v4
  # auto-detects sources by walking up to the nearest git root and skipping
  # .gitignore'd paths; inside an AUR build tree (this source lives under the
  # package repo's ignored src/ dir) that makes it scan nothing and produce an
  # unstyled app. src/App.css pins the scan with @source to prevent this — fail
  # loudly here if a future change regresses it, rather than shipping a broken
  # package.
  if ! grep -qE '\.flex\{|\.grid\{|\.items-center\{' dist/assets/*.css 2>/dev/null; then
    echo "build(): produced CSS contains no Tailwind utilities — refusing to package an unstyled app" >&2
    return 1
  fi
}

package() {
  cd "${pkgname}-${pkgver}"
  install -dm755 "${pkgdir}"
  local deb
  deb="$(find "src-tauri/target/release/bundle/deb" -maxdepth 1 -name "${pkgname}_*_amd64.deb" -print -quit)"
  [[ -n "$deb" ]] || { echo "package(): no .deb produced under src-tauri/target/release/bundle/deb"; return 1; }
  # Tauri v2 picks the compression for the inner data archive (xz or zst)
  # depending on the dpkg-buildflags available at build time; probe instead
  # of guessing so the same PKGBUILD works across toolchain variants.
  local work data_archive
  work=$(mktemp -d)
  pushd "$work" >/dev/null
  ar x "$OLDPWD/$deb"
  for ext in zst xz gz; do
    if [[ -f "data.tar.$ext" ]]; then
      data_archive="data.tar.$ext"
      break
    fi
  done
  popd >/dev/null
  if [[ -z "${data_archive:-}" ]]; then
    echo "package(): no data.tar.* member found in $deb"
    rm -rf "$work"
    return 1
  fi
  bsdtar -x -C "${pkgdir}" -f "$work/$data_archive"
  rm -rf "$work"
}
