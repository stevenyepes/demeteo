# Copy to deploy/hub/.env and replace every placeholder. Never commit .env.

POSTGRES_USER=demeteo
# URL-safe only (compose pastes it into DATABASE_URL): openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=demeteo_hub

DEMETEO_HUB_DOMAIN=hub.example.com
DEMETEO_HUB_UPSTREAM=hub:8080
DEMETEO_HUB_BIND=0.0.0.0:8080
DEMETEO_HUB_PUBLIC_URL=https://hub.example.com
DEMETEO_HUB_RP_ID=hub.example.com

OPENBAO_ADDR=http://openbao:8200
BAO_API_ADDR=http://openbao:8200
OPENBAO_TOKEN=replace-with-a-least-privilege-transit-token
DEMETEO_HUB_TRANSIT_MOUNT=transit
DEMETEO_HUB_TRANSIT_KEY=demeteo-hub
